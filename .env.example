# Copy to .env locally. Never commit actual secrets. Values are placeholders.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./clinsync_demo.db

# Gemini is the primary generative model. Keep credentials on the server.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Groq fallback for compatible text-only generation tasks. Disabled by default.
LLM_FALLBACK_PROVIDER=none
GROQ_API_KEY=
# Required only when LLM_FALLBACK_PROVIDER=groq. Choose a model currently available to your account.
GROQ_MODEL=

# Tracing is opt-in. Use synthetic test data and redact sensitive content.
TRACE_ENABLED=false
TRACE_PUBLIC_KEY=
TRACE_SECRET_KEY=
TRACE_HOST=
